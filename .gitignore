__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
# Ignore the built Lean project (.lake alone is ~7GB) but DO commit the pins:
# the toolchain and Mathlib rev are the whole point of issue #6.
lean_project/*
!lean_project/lakefile.toml
!lean_project/lean-toolchain
# The RESOLVED dependency SHAs. lakefile.toml pins Mathlib by TAG, but seven
# transitive deps (batteries, aesop, Qq, proofwidgets, importGraph, plausible,
# LeanSearchClient) are pinned to floating main/master. Without this manifest a
# fresh `lake update` resolves them differently and issue #6 reopens. 3 KB.
!lean_project/lake-manifest.json
lean_project.lock

